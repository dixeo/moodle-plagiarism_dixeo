<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="plagiarism/dixeo/db" VERSION="20260925" COMMENT="XMLDB file for plagiarism_dixeo"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="plagiarism_dixeo_authorship" COMMENT="Authorship confidence records: initial score, quiz, responses, final score.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="component" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Component e.g. mod_assign"/>
        <FIELD NAME="area" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Type e.g. submission, forum_post"/>
        <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Item id for the component (e.g. submission id)"/>
        <FIELD NAME="initial_confidence" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="true" SEQUENCE="false" COMMENT="0-100 score: 0=AI, 100=Human"/>
        <FIELD NAME="quiz_data" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Generated quiz as JSON"/>
        <FIELD NAME="quiz_responses" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Student quiz responses as JSON"/>
        <FIELD NAME="quiz_grade" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" SEQUENCE="false" COMMENT="Objective grade 0-100 from correct answers (e.g. 3/4 = 75)"/>
        <FIELD NAME="final_confidence" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="false" SEQUENCE="false" COMMENT="Final score after quiz evaluation"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Student user id"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="user_component_itemid" TYPE="unique" FIELDS="userid, component, itemid"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
