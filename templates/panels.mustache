{{!
    @template plagiarism_dixeo/panels

    Authorship status panels shown beside a submission.

    Titles are plain text and are escaped here. The body is the only field rendered as HTML
    and callers pass it through format_text() before it reaches this template.

    Context variables required for this template:
    * containerid string - Unique id for the panel container.
    * panels array - One entry per panel:
        * title string - Header text.
        * headerclass string - Bootstrap classes for the header.
        * haslink bool - Whether the header opens the verification quiz.
        * recordid int - Authorship record the quiz belongs to.
        * cmid int - Course module id.
        * hasbody bool - Whether the panel has body content.
        * body string - Body HTML produced by format_text().
        * collapsible bool - Whether the body starts collapsed.
        * collapseid string - Unique id of the collapsible region.
        * maximizelabel string - Accessible label for the maximize button.

    Example context (json):
    {
        "containerid": "plagiarism-dixeo-panels-42",
        "panels": [
            {
                "title": "Final score: 82.5%",
                "headerclass": "bg-success text-white",
                "haslink": false,
                "recordid": 0,
                "cmid": 42,
                "hasbody": true,
                "body": "<p>The writing matches the student's earlier work.</p>",
                "collapsible": false,
                "collapseid": "",
                "maximizelabel": "Maximize"
            }
        ]
    }
}}
<div id="{{containerid}}" class="plagiarism-dixeo-panels mt-2">
    {{#panels}}
        <div class="card plagiarism-dixeo-panel m-2">
            <div class="card-header plagiarism-dixeo-panel-header {{headerclass}}"
                {{#collapsible}}
                    role="button" tabindex="0" data-toggle="collapse" data-target="#{{collapseid}}"
                    aria-expanded="false" aria-controls="{{collapseid}}"
                {{/collapsible}}
            >
                <div class="plagiarism-dixeo-panel-header-title">
                    {{#haslink}}
                        <a href="#" role="button"
                            class="plagiarism-dixeo-open-verification-modal text-white text-decoration-none btn btn-link p-0"
                            data-record-id="{{recordid}}" data-cmid="{{cmid}}">{{title}}</a>
                    {{/haslink}}
                    {{^haslink}}
                        {{title}}
                    {{/haslink}}
                </div>
                {{#hasbody}}
                    <button type="button"
                        class="btn btn-outline-default text-white btn-sm plagiarism-dixeo-panel-maximize p-0"
                        aria-label="{{maximizelabel}}" title="{{maximizelabel}}">
                        <span class="icon fa fa-expand fa-fw" aria-hidden="true"></span>
                    </button>
                {{/hasbody}}
            </div>
            {{#hasbody}}
                {{#collapsible}}
                    <div class="collapse" id="{{collapseid}}">
                        <div class="card-body">
                            <div class="card-text mb-0">{{{body}}}</div>
                        </div>
                    </div>
                {{/collapsible}}
                {{^collapsible}}
                    <div class="card-body">
                        <div class="card-text mb-0">{{{body}}}</div>
                    </div>
                {{/collapsible}}
            {{/hasbody}}
        </div>
    {{/panels}}
</div>
