{{!
    Authorship status panels (pending, verification required, or score cards with optional explanation).
    Loads the panel AMD module for maximize/minimize when panels have body content.

    @template plagiarism_dixeo/panels
    @param string containerid ID for the panels container (e.g. plagiarism-dixeo-panels-123).
    @param array panels List of panel objects: titlehtml, headerclass, hasbody, bodyhtml, collapsible, collapseid, maximizelabel.
}}
<div id="{{containerid}}" class="plagiarism-dixeo-panels mt-2">
{{#panels}}
    <div class="card plagiarism-dixeo-panel m-2">
        <div class="card-header plagiarism-dixeo-panel-header {{headerclass}}"{{#collapsible}} data-toggle="collapse" data-target="#{{collapseid}}" aria-expanded="false" aria-controls="{{collapseid}}" style="cursor: pointer;"{{/collapsible}}>
            <div class="plagiarism-dixeo-panel-header-title">{{{titlehtml}}}</div>
            {{#hasbody}}
            <button type="button" class="btn btn-outline-default text-white btn-sm plagiarism-dixeo-panel-maximize p-0" aria-label="{{maximizelabel}}" title="{{maximizelabel}}">
                <span class="icon fa fa-expand fa-fw" aria-hidden="true"></span>
            </button>
            {{/hasbody}}
        </div>
        {{#collapsible}}
        <div class="collapse" id="{{collapseid}}">
            <div class="card-body">
                <div class="card-text mb-0">{{{bodyhtml}}}</div>
            </div>
        </div>
        {{/collapsible}}
        {{^collapsible}}
        {{#hasbody}}
        <div class="card-body">
            <div class="card-text mb-0">{{{bodyhtml}}}</div>
        </div>
        {{/hasbody}}
        {{/collapsible}}
    </div>
{{/panels}}
</div>
